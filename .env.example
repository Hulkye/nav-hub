# PostgreSQL 数据库密码；Docker Compose 启动 PostgreSQL 时使用。
POSTGRES_PASSWORD=
# API 连接 PostgreSQL 的完整连接字符串；密码中的特殊字符需要 URL 编码。
DATABASE_URL=postgresql://navhub:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/navhub
# 对外访问地址；用于安全 Cookie、请求来源校验和公开链接生成。
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# API 内部地址；前台构建代理请求时使用。
API_ORIGIN=http://127.0.0.1:3002
# 管理台内部地址；前台构建 /admin 代理时使用。
ADMIN_ORIGIN=http://127.0.0.1:3001
# 可信代理 IP 列表，使用逗号分隔；为空时忽略 X-Forwarded-For。
NUXT_TRUSTED_PROXY_IPS=
# 初始管理员用户名；仅供一次性 admin:create 命令使用。
ADMIN_USERNAME=
# 初始管理员密码；仅供一次性 admin:create 命令使用，不要提交真实密码。
ADMIN_PASSWORD=
# 数据库备份输出目录；生产环境应使用应用容器外的受控持久化目录。
BACKUP_DIR=./backups
# 保留的已验证本地备份数量。
BACKUP_RETENTION=14
# 对象存储兼容 S3 协议；本地通过 Docker Compose 启动 MinIO。
# S3_ENDPOINT：S3 兼容服务地址；本地 MinIO 默认使用此地址。
S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION：对象存储区域；MinIO 可使用默认区域 us-east-1。
S3_REGION=us-east-1
# S3_BUCKET：保存图片对象的存储桶名称；MinIO 初始化时会自动创建。
S3_BUCKET=navhub
# S3_ACCESS_KEY_ID：对象存储访问密钥 ID；本地必须与 MINIO_ROOT_USER 一致。
S3_ACCESS_KEY_ID=navhub
# S3_SECRET_ACCESS_KEY：对象存储访问密钥；请替换为足够长的随机值，并与 MINIO_ROOT_PASSWORD 一致。
S3_SECRET_ACCESS_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE
# S3_FORCE_PATH_STYLE：是否使用路径式存储桶寻址；MinIO 必须设为 true。
S3_FORCE_PATH_STYLE=true
